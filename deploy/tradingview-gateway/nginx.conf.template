map $ssl_client_s_dn $tradingview_client_subject_ok {
    default 0;
    ~*CN=webhook-server@tradingview\.com 1;
}

server {
    listen 443 ssl;
    server_name _;

    server_tokens off;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    # TradingView presents a client certificate for HTTPS webhook delivery.
    # optional_no_ca is used because TradingView documents the certificate
    # identity fields but does not publish a dedicated webhook CA bundle.
    # Source-IP allowlisting is therefore mandatory in this gateway.
    ssl_verify_client optional_no_ca;
    ssl_client_certificate /etc/ssl/certs/ca-certificates.crt;

    client_max_body_size 64k;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = /webhooks/tradingview {
        # Official TradingView webhook sender IPs.
        allow 52.89.214.238;
        allow 34.212.75.30;
        allow 54.218.53.128;
        allow 52.32.178.7;
        deny all;

        # A client certificate must be presented and identify TradingView.
        if ($ssl_client_verify = "NONE") {
            return 403;
        }

        if ($tradingview_client_subject_ok = 0) {
            return 403;
        }

        limit_except POST {
            deny all;
        }

        proxy_http_version 1.1;

        # Never trust a credential supplied by the public caller.
        # This overwrites the inbound header with the gateway-only secret.
        proxy_set_header X-TradeOps-TradingView-Gateway-Key "${TRADEOPS_TRADINGVIEW_GATEWAY_KEY}";

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;

        # TradingView cancels webhook requests that exceed its short deadline.
        proxy_connect_timeout 500ms;
        proxy_send_timeout 2s;
        proxy_read_timeout 2s;

        proxy_pass http://api:8080/api/integrations/tradingview;
    }

    location / {
        return 404;
    }
}
