# TradeOps v1.3.1.0 client pilot environment
# Copy this file to a private location, fill it in, and do not commit the populated copy.

# Execution provider: Mock or BybitTestnet.
TRADEOPS_EXCHANGE_PROVIDER=Mock

# Internal Nginx-gateway -> TradeOps credential. Use a random value >= 32 characters.
TRADEOPS_TRADINGVIEW_GATEWAY_KEY=CHANGE_ME_RANDOM_GATEWAY_SECRET_32_PLUS

# Separate credential for mutating operator actions. Use a different random value >= 32 characters.
TRADEOPS_OPERATOR_API_KEY=CHANGE_ME_RANDOM_OPERATOR_SECRET_32_PLUS

# Absolute host paths to the public TLS certificate and private key used by the TradingView gateway.
TRADEOPS_TRADINGVIEW_TLS_CERT=/ABSOLUTE/PATH/TO/fullchain.pem
TRADEOPS_TRADINGVIEW_TLS_KEY=/ABSOLUTE/PATH/TO/privkey.pem

# Required only when TRADEOPS_EXCHANGE_PROVIDER=BybitTestnet.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Optional TradingView health tuning.
TRADEOPS_TRADINGVIEW_HEALTH_INTERVAL_SECONDS=60
TRADEOPS_TRADINGVIEW_HEALTH_LOOKBACK_MINUTES=15
TRADEOPS_TRADINGVIEW_HEALTH_MINIMUM_DELIVERIES=5
TRADEOPS_TRADINGVIEW_HEALTH_CRITICAL_FAILURE_COUNT=2
TRADEOPS_TRADINGVIEW_HEALTH_CRITICAL_FAILURE_RATE_PERCENT=20
TRADEOPS_TRADINGVIEW_HEALTH_CONFLICT_RATE_PERCENT=20
TRADEOPS_TRADINGVIEW_HEALTH_RISK_REJECTED_RATE_PERCENT=50
TRADEOPS_TRADINGVIEW_HEALTH_MAX_AVERAGE_LATENCY_MS=1000
TRADEOPS_TRADINGVIEW_HEALTH_NO_SUCCESS_MINUTES=0

# Optional Telegram operations alerts.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
